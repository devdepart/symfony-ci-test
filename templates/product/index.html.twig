{% extends 'base.html.twig' %}

{% block title %}Products{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>Products</h1>

        <a class="button" href="{{ path('product_new') }}">
            Create product
        </a>
    </div>

    {% if products is empty %}
        <div class="empty-state">
            <p>No products have been created yet.</p>

            <a class="button" href="{{ path('product_new') }}">
                Create your first product
            </a>
        </div>
    {% else %}
        <table>
            <thead>
				<tr>
					<th>ID</th>
					<th>Name</th>
					<th>Price</th>
					<th>Created</th>
					<th>Actions</th>
				</tr>
            </thead>

            <tbody>
				{% for product in products %}
					<tr>
						<td>{{ product.id }}</td>
						<td>{{ product.name }}</td>
						<td>
							${{ '%d.%02d'|format(
                            product.price // 100,
                            product.price % 100
                        ) }}
						</td>
						<td>{{ product.createdAt|date('Y-m-d H:i') }}</td>
						<td>
							<div class="actions">
								<a href="{{ path('product_show', {id: product.id}) }}">
									View
								</a>

								<a href="{{ path('product_edit', {id: product.id}) }}">
									Edit
								</a>

								<form
									method="post"
									action="{{ path('product_delete', {id: product.id}) }}"
									onsubmit="return confirm('Delete this product?');"
									>
									<input
										type="hidden"
										name="_token"
										value="{{ csrf_token('delete-product-' ~ product.id) }}"
										>

									<button class="button button-danger" type="submit">
										Delete
									</button>
								</form>
							</div>
						</td>
					</tr>
				{% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
